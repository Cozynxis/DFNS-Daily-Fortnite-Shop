{
  "name": "dfns-daily-fortnite-shop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-web.ps1",
    "android:sync": "npm run prepare:web && npx cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "apk": "npm run android:build"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
